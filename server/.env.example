# -------------------------------------------------------------
# MODE 1: Local Development with Ollama (Default)
# -------------------------------------------------------------
PORT=3001
OLLAMA_URL=http://localhost:11434
MODEL=qwen3:8b
MIN_MINUTES=360

# -------------------------------------------------------------
# MODE 2: Cloud Deployment (Render, Railway, etc.)
# -------------------------------------------------------------
# Get a free API key at https://console.groq.com (no credit card required)
# GROQ_API_KEY=gsk_your_groq_api_key_here
# MODEL=llama-3.1-8b-instant
#
# Or any other OpenAI-compatible cloud provider (OpenRouter, DeepSeek, Together, etc.):
# LLM_API_KEY=your_key_here
# LLM_BASE_URL=https://openrouter.ai/api/v1
# MODEL=qwen/qwen-2.5-7b-instruct:free